# Copy this file to .env and fill in your real values. NEVER commit .env to GitLab.

# --- For deploying to Sepolia testnet (real, public blockchain) ---
# Free RPC endpoint from https://www.alchemy.com or https://infura.io
SEPOLIA_RPC_URL=

# Private key of a wallet funded with free Sepolia test ETH (from a faucet).
# Use a DEDICATED throwaway wallet for this project. Never use a real wallet's key.
PRIVATE_KEY=

# --- Filled in automatically after deployment (see scripts/deploy.js output) ---
CONTRACT_ADDRESS=

# --- Backend config ---
# Which network the backend should talk to: "localhost" or "sepolia"
NETWORK=localhost
RPC_URL=http://127.0.0.1:8545

# Directory of log files the watcher should monitor
LOG_DIR=./logs

# Capture real Windows Event Log entries (firewall/network events by default)
WINDOWS_EVENT_LOG_ENABLED=true
WINDOWS_EVENT_CHANNELS=Microsoft-Windows-Windows Firewall With Advanced Security/Firewall

# How often (minutes) the watcher anchors a new batch automatically
ANCHOR_INTERVAL_MINUTES=5

# Backend HTTP port
PORT=4000
